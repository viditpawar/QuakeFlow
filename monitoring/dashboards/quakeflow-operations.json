{
  "uid": "quakeflow-operations",
  "title": "QuakeFlow operations",
  "tags": [
    "quakeflow"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Right now",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Events ingested",
      "description": "Valid events read from the feeds in the selected time range, before deduplication.",
      "datasource": {
        "type": "prometheus",
        "uid": "quakeflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "quakeflow-prometheus"
          },
          "expr": "sum(increase(quakeflow_events_ingested_total[$__range]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "New revisions",
      "description": "Distinct revisions seen for the first time in the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "quakeflow-prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "quakeflow-prometheus"
          },
          "expr": "sum(increase(quakeflow_revisions_detected_total[$__range]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Source freshness",
      "description": "Age of the newest USGS update the collector has seen. Grows if polling stops or USGS goes quiet.",
      "datasource": {
        "type": "prometheus",
        "uid": "quakeflow-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "quakeflow-prometheus"
          },
          "expr": "quakeflow_source_freshness_seconds",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 600
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Pending revisions",
      "description": "Detected but not yet confirmed by Kafka. Should be 0 after each poll.",
      "datasource": {
        "type": "prometheus",
        "uid": "quakeflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "quakeflow-prometheus"
          },
          "expr": "quakeflow_pending_revisions",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Invalid records",
      "description": "Feed records that failed validation in the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "quakeflow-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "quakeflow-prometheus"
          },
          "expr": "sum(increase(quakeflow_invalid_records_total[$__range]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Kafka consumer lag",
      "description": "Records the Flink job has not consumed yet, summed over all topics it reads.",
      "datasource": {
        "type": "prometheus",
        "uid": "quakeflow-prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "quakeflow-prometheus"
          },
          "expr": "sum(kafka_consumergroup_lag{consumergroup=~\"quakeflow.*\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Collector",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Events ingested per second, by feed",
      "description": "Valid events read from each feed.",
      "datasource": {
        "type": "prometheus",
        "uid": "quakeflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "quakeflow-prometheus"
          },
          "expr": "sum by (feed) (rate(quakeflow_events_ingested_total[5m]))",
          "legendFormat": "{{feed}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "New revisions per second, by kind",
      "description": "new: first sighting. revised: newer update. out_of_order: older than one already known. conflict: same update time, different content.",
      "datasource": {
        "type": "prometheus",
        "uid": "quakeflow-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "quakeflow-prometheus"
          },
          "expr": "sum by (kind) (rate(quakeflow_revisions_detected_total[5m]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Source freshness",
      "description": "Seconds since the newest USGS update seen.",
      "datasource": {
        "type": "prometheus",
        "uid": "quakeflow-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "quakeflow-prometheus"
          },
          "expr": "quakeflow_source_freshness_seconds",
          "legendFormat": "freshness",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Ingestion latency (USGS update to Kafka confirmation)",
      "description": "Median and 95th percentile. Revisions found in the day feed can already be hours old, which shows here.",
      "datasource": {
        "type": "prometheus",
        "uid": "quakeflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "quakeflow-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(quakeflow_ingestion_latency_seconds_bucket[15m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "quakeflow-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(quakeflow_ingestion_latency_seconds_bucket[15m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Invalid records per second",
      "description": "Feed records rejected by validation.",
      "datasource": {
        "type": "prometheus",
        "uid": "quakeflow-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "quakeflow-prometheus"
          },
          "expr": "sum by (feed) (rate(quakeflow_invalid_records_total[5m]))",
          "legendFormat": "{{feed}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Feed polls by outcome",
      "description": "Failed polls are retried with backoff.",
      "datasource": {
        "type": "prometheus",
        "uid": "quakeflow-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "quakeflow-prometheus"
          },
          "expr": "sum by (feed, outcome) (increase(quakeflow_feed_polls_total[10m]))",
          "legendFormat": "{{feed}} {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "row",
      "title": "Kafka and Flink",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Kafka consumer lag",
      "description": "Unprocessed records per consumer group and topic.",
      "datasource": {
        "type": "prometheus",
        "uid": "quakeflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "quakeflow-prometheus"
          },
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag)",
          "legendFormat": "{{consumergroup}} {{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Flink checkpoints",
      "description": "Completed and failed checkpoints. Failures are the signal to investigate.",
      "datasource": {
        "type": "prometheus",
        "uid": "quakeflow-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "quakeflow-prometheus"
          },
          "expr": "sum(flink_jobmanager_job_numberOfCompletedCheckpoints)",
          "legendFormat": "completed",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "quakeflow-prometheus"
          },
          "expr": "sum(flink_jobmanager_job_numberOfFailedCheckpoints)",
          "legendFormat": "failed",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Flink last checkpoint duration",
      "description": "How long the latest checkpoint took.",
      "datasource": {
        "type": "prometheus",
        "uid": "quakeflow-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "quakeflow-prometheus"
          },
          "expr": "max(flink_jobmanager_job_lastCheckpointDuration)",
          "legendFormat": "duration",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 19,
      "type": "row",
      "title": "Lakehouse (Spark jobs)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Spark job duration",
      "description": "Duration of the last run of each job, reported when it finished.",
      "datasource": {
        "type": "prometheus",
        "uid": "quakeflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "quakeflow-prometheus"
          },
          "expr": "quakeflow_spark_job_duration_seconds",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Time since last successful run",
      "description": "A job that is not run, or keeps failing, keeps climbing.",
      "datasource": {
        "type": "prometheus",
        "uid": "quakeflow-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "quakeflow-prometheus"
          },
          "expr": "time() - quakeflow_spark_job_last_success_timestamp_seconds",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Gold quality gate",
      "description": "Failed checks in the last Gold build. Anything above 0 means Gold was not updated.",
      "datasource": {
        "type": "prometheus",
        "uid": "quakeflow-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 32,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "quakeflow-prometheus"
          },
          "expr": "quakeflow_gold_checks_failed",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Last Spark run",
      "description": "1 if the last run of the job succeeded.",
      "datasource": {
        "type": "prometheus",
        "uid": "quakeflow-prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 32,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "quakeflow-prometheus"
          },
          "expr": "min(quakeflow_spark_job_success)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}