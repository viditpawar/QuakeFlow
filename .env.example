# Copy to .env and adjust. Never commit .env.
# Feed URLs and polling intervals live in configs/sources.yaml.
QUAKEFLOW_SOURCES_CONFIG=configs/sources.yaml
QUAKEFLOW_STATE_DB=data/quakeflow_state.db
USGS_CATALOG_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Lakehouse (docker compose --profile batch). These defaults are for local use only.
POSTGRES_DB=iceberg_catalog
POSTGRES_USER=quakeflow
POSTGRES_PASSWORD=quakeflow-local-password
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=quakeflow
S3_SECRET_KEY=quakeflow-local-secret
WAREHOUSE_BUCKET=warehouse
